{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDFReader",
  "version": "0.0.1",
  "identifier": "com.pdfpro.reader",
  "build": {
    "beforeDevCommand": "node tools/build-web.js",
    "beforeBuildCommand": "node tools/build-web.js",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PDF 阅读器",
        "url": "app/index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF 文档",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
